<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Dark mode tool: asks System Events to switch the appearance. Required under the hardened runtime. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Calendar section: reading today's events under the hardened runtime. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- Dictation: the microphone, only while dictating. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
